{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolios",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  }
}
